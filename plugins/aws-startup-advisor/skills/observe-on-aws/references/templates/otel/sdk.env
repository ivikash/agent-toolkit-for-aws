# OpenTelemetry SDK settings for the application container or process.
# The same four lines on every platform and in every language. Nothing about
# export endpoints: the ADOT SDK defaults to the collector next to it
# (localhost:4318 for Python, Node.js and .NET, localhost:4317 for Java), which
# is where the CloudWatch agent sidecar listens.
#
# service.version is the commit SHA the deploy-from-github pipeline passes as
# image_tag, so every trace, log and metric names the version that produced it,
# and a deploy shows up as a step change in the dashboards.

OTEL_SERVICE_NAME={{APP_NAME}}
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name={{STAGE}},service.version={{SERVICE_VERSION}},service.namespace={{APP_NAME}}
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG={{SAMPLE_RATIO}}
