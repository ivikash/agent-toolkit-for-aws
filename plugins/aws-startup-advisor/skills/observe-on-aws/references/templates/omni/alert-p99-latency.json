{
  "spaceId": "{{SPACE_ID}}",
  "profileId": "{{PROFILE_ID}}",
  "name": "{{APP_NAME}}-{{STAGE}}-p99-latency",
  "description": "{{APP_NAME}} {{STAGE}}: p99 span duration over the last 5 minutes, in seconds",
  "rule": {
    "telemetryRule": {
      "query": {
        "language": "PROMQL",
        "expression": "histogram_quantile(0.99, rate({__name__=\"traces.span.metrics.duration\", \"@resource.service.name\"=\"{{APP_NAME}}\"}[5m]))"
      },
      "condition": {
        "thresholdMode": "FIELD_VALUE",
        "comparator": "GT",
        "criticalThreshold": {{P99_LATENCY_SECONDS}}
      },
      "evaluation": {
        "intervalSeconds": 300,
        "pendingDurationSeconds": 300
      },
      "noData": {
        "treatAs": "OK"
      }
    }
  },
  "notificationsEnabled": true,
  "notificationRules": [
    {
      "trigger": { "stateValues": ["CRITICAL"] },
      "target": { "type": "sns", "arn": "{{SNS_TOPIC_ARN}}" }
    }
  ],
  "tags": { "app": "{{APP_NAME}}", "stage": "{{STAGE}}", "managed-by": "observe-on-aws" }
}
